{
  "version": 5,
  "cmakeMinimumRequired": {
    "major": 3,
    "minor": 24,
    "patch": 0
  },
  "configurePresets": [
    {
      "name": "macos-arm64-base",
      "hidden": true,
      "generator": "Ninja",
      "cacheVariables": {
        "CMAKE_OSX_ARCHITECTURES": "arm64",
        "CMAKE_OSX_DEPLOYMENT_TARGET": "15.0",
        "CMAKE_POLICY_VERSION_MINIMUM": "3.5",
        "HP2_REQUIRE_IMPLEMENTED_SOURCES": "ON"
      }
    },
    {
      "name": "macos-arm64",
      "displayName": "macOS 15 arm64 Release",
      "inherits": "macos-arm64-base",
      "binaryDir": "${sourceDir}/out/macos-arm64",
      "installDir": "${sourceDir}/out/install/macos-arm64",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "CMAKE_INSTALL_PREFIX": "${sourceDir}/out/install/macos-arm64",
        "HP2_ENABLE_ASAN_UBSAN": "OFF",
        "HP2_ENABLE_TSAN": "OFF"
      }
    },
    {
      "name": "macos-arm64-asan-ubsan",
      "displayName": "macOS 15 arm64 ASan+UBSan",
      "inherits": "macos-arm64-base",
      "binaryDir": "${sourceDir}/out/macos-arm64-asan-ubsan",
      "installDir": "${sourceDir}/out/install/macos-arm64-asan-ubsan",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "RelWithDebInfo",
        "CMAKE_INSTALL_PREFIX": "${sourceDir}/out/install/macos-arm64-asan-ubsan",
        "HP2_ENABLE_ASAN_UBSAN": "ON",
        "HP2_ENABLE_TSAN": "OFF"
      }
    },
    {
      "name": "macos-arm64-tsan",
      "displayName": "macOS 15 arm64 TSan",
      "inherits": "macos-arm64-base",
      "binaryDir": "${sourceDir}/out/macos-arm64-tsan",
      "installDir": "${sourceDir}/out/install/macos-arm64-tsan",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "RelWithDebInfo",
        "CMAKE_INSTALL_PREFIX": "${sourceDir}/out/install/macos-arm64-tsan",
        "HP2_ENABLE_ASAN_UBSAN": "OFF",
        "HP2_ENABLE_TSAN": "ON"
      }
    },
    {
      "name": "macos-arm64-full-smoke",
      "displayName": "macOS 15 arm64 Release + full map sweep",
      "inherits": "macos-arm64-base",
      "binaryDir": "${sourceDir}/out/macos-arm64-full-smoke",
      "installDir": "${sourceDir}/out/install/macos-arm64-full-smoke",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "HP2_ENABLE_FULL_MAP_SMOKE": "ON"
      }
    },
    {
      "name": "macos-arm64-vulkan",
      "displayName": "macOS 15 arm64 Release + Vulkan driver",
      "inherits": "macos-arm64-base",
      "binaryDir": "${sourceDir}/out/macos-arm64-vulkan",
      "installDir": "${sourceDir}/out/install/macos-arm64-vulkan",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "HP2_ENABLE_VULKAN_DRIVER": "ON"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "macos-arm64",
      "configurePreset": "macos-arm64"
    },
    {
      "name": "macos-arm64-asan-ubsan",
      "configurePreset": "macos-arm64-asan-ubsan"
    },
    {
      "name": "macos-arm64-tsan",
      "configurePreset": "macos-arm64-tsan"
    },
    {
      "name": "macos-arm64-full-smoke",
      "configurePreset": "macos-arm64-full-smoke"
    },
    {
      "name": "macos-arm64-vulkan",
      "configurePreset": "macos-arm64-vulkan"
    }
  ],
  "testPresets": [
    {
      "name": "macos-arm64",
      "displayName": "macOS 15 arm64 Release tests",
      "configurePreset": "macos-arm64",
      "output": { "outputOnFailure": true },
      "execution": { "noTestsAction": "error" }
    },
    {
      "name": "macos-arm64-asan-ubsan",
      "displayName": "macOS 15 arm64 ASan+UBSan tests",
      "configurePreset": "macos-arm64-asan-ubsan",
      "output": { "outputOnFailure": true },
      "execution": { "noTestsAction": "error" }
    },
    {
      "name": "macos-arm64-tsan",
      "displayName": "macOS 15 arm64 TSan tests",
      "configurePreset": "macos-arm64-tsan",
      "output": { "outputOnFailure": true },
      "execution": { "noTestsAction": "error" }
    },
    {
      "name": "macos-arm64-full-smoke",
      "displayName": "macOS 15 arm64 full sweep tests",
      "configurePreset": "macos-arm64-full-smoke",
      "output": { "outputOnFailure": true },
      "execution": { "noTestsAction": "error" }
    },
    {
      "name": "macos-arm64-vulkan",
      "displayName": "macOS 15 arm64 Vulkan tests",
      "configurePreset": "macos-arm64-vulkan",
      "output": { "outputOnFailure": true },
      "execution": { "noTestsAction": "error" }
    }
  ]
}

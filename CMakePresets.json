  "configurePresets": [
    {
      "name": "macos-arm64-base",
      "hidden": true,
      "generator": "Ninja",
      "cacheVariables": {
        "CMAKE_OSX_ARCHITECTURES": "arm64",
        "CMAKE_OSX_DEPLOYMENT_TARGET": "15.0",
        "CMAKE_POLICY_VERSION_MINIMUM": "3.5",
        "HP2_REQUIRE_IMPLEMENTED_SOURCES": "ON"
      }
    },
    {
      "name": "macos-arm64",
      "displayName": "macOS 15 arm64 Release",
      "inherits": "macos-arm64-base",
      "binaryDir": "${sourceDir}/out/macos-arm64",
      "installDir": "${sourceDir}/out/install/macos-arm64",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "CMAKE_INSTALL_PREFIX": "${sourceDir}/out/install/macos-arm64",
        "HP2_ENABLE_ASAN_UBSAN": "OFF",
        "HP2_ENABLE_TSAN": "OFF"
      }
    },
    {
      "name": "macos-arm64-asan-ubsan",

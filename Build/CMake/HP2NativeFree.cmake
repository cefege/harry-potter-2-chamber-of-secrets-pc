include_guard(GLOBAL)

# Keep the query available on reconfigure. CMake reads queries before it runs
# CMakeLists.txt, so CI/release must also seed this file before the first configure.
# See Docs/NATIVE_FREE_AUDIT.md for the equivalent local preparation commands.
file(MAKE_DIRECTORY "${CMAKE_BINARY_DIR}/.cmake/api/v1/query")
file(WRITE "${CMAKE_BINARY_DIR}/.cmake/api/v1/query/codemodel-v2" "")

# Call after product targets and their link properties are finalized. The JSON
# is generator-produced so $<TARGET_FILE:...> is the configured artifact path.
function(hp2_enable_cargo_provenance target)
    if(NOT TARGET "${target}")
        message(FATAL_ERROR "hp2_enable_cargo_provenance names missing target: ${target}")
    endif()
    if(NOT TARGET "_cargo-build_${target}")
        message(FATAL_ERROR "hp2_enable_cargo_provenance requires Corrosion target ${target}")
    endif()
    find_package(Python3 COMPONENTS Interpreter REQUIRED)

    set(_artifact_dir "${CMAKE_BINARY_DIR}/Testing/HP2/${target}_producer/Artifacts")
    file(MAKE_DIRECTORY "${_artifact_dir}")
    set(_record "${_artifact_dir}/cargo-provenance.json")
    set(_capture "${CMAKE_SOURCE_DIR}/Build/capture_cargo_provenance.py")

    get_target_property(_original_cargo "${target}" INTERFACE_CORROSION_CARGO)
    if(NOT _original_cargo OR _original_cargo STREQUAL "_original_cargo-NOTFOUND")
        set(_original_cargo "${_CORROSION_CARGO}")
    endif()
    if(NOT _original_cargo AND TARGET Rust::Cargo)
        get_property(_original_cargo TARGET Rust::Cargo PROPERTY IMPORTED_LOCATION)
    endif()
    if(NOT _original_cargo)
        message(FATAL_ERROR "Cannot determine Cargo executable for Corrosion target ${target}")
    endif()
    if(_original_cargo MATCHES "\\$<" OR _original_cargo MATCHES ";")
        message(FATAL_ERROR "Cargo provenance requires a single concrete Cargo executable for ${target}")
    endif()
    if(NOT COMMAND corrosion_set_env_vars)
        message(FATAL_ERROR "Cargo provenance requires Corrosion's corrosion_set_env_vars API")
    endif()

    # Corrosion's supported per-target executable override replaces its actual
    # cargo command token; the proxy executes the saved Cargo binary once.
    set_property(TARGET "${target}" PROPERTY INTERFACE_CORROSION_CARGO "${_capture}")
    corrosion_set_env_vars("${target}"
        "HP2_CARGO_PROVENANCE_TARGET=${target}"
        "HP2_CARGO_PROVENANCE_RECORD=${_record}"
        "HP2_CARGO_PROVENANCE_EXECUTABLE=${_original_cargo}")
    # Opt-in qualification mode is deliberately separate from schema-3 builds.
    # It rejects unsupported wrappers and requires a rebuilt binary.
    if(HP2_NATIVE_FREE_FINAL_BIN)
        corrosion_set_env_vars("${target}" "HP2_CARGO_PROVENANCE_MODE=final-bin-v1")
    endif()

    # Cargo JSON events are required for authentic artifact and build-script
    # provenance; add this option to the selected cargo rustc invocation.
    get_target_property(_cargo_flags "${target}" INTERFACE_CORROSION_CARGO_FLAGS)
    if(NOT "--message-format=json-render-diagnostics" IN_LIST _cargo_flags)
        set_property(TARGET "${target}" APPEND PROPERTY INTERFACE_CORROSION_CARGO_FLAGS
            "--message-format=json-render-diagnostics")
    endif()
    set_property(TARGET "${target}" PROPERTY HP2_NATIVE_FREE_CARGO_PROVENANCE "${_record}")
endfunction()

function(_hp2_nf_capture_header output target source_dir header_path template_path cmake_path input_path)
    if(NOT EXISTS "${header_path}" OR NOT EXISTS "${template_path}" OR
       NOT EXISTS "${cmake_path}" OR NOT EXISTS "${input_path}")
        return()
    endif()
    file(RELATIVE_PATH _relative_path "${CMAKE_BINARY_DIR}" "${header_path}")
    file(SHA256 "${header_path}" _output_hash)
    file(SHA256 "${template_path}" _template_hash)
    file(SHA256 "${cmake_path}" _cmake_hash)
    file(SHA256 "${input_path}" _input_hash)
    set(_record
        "{\"target\":\"${target}\",\"path\":\"${_relative_path}\",\"source_dir\":\"${source_dir}\",\"cmake_source\":\"${cmake_path}\",\"cmake_sha256\":\"${_cmake_hash}\",\"input_source\":\"${input_path}\",\"input_sha256\":\"${_input_hash}\",\"template_path\":\"${template_path}\",\"template_sha256\":\"${_template_hash}\",\"sha256\":\"${_output_hash}\"}")
    if(${output})
        string(APPEND ${output} ",")
    endif()
    string(APPEND ${output} "${_record}")
    set(${output} "${${output}}" PARENT_SCOPE)
endfunction()

function(_hp2_native_free_generated_headers output)
    set(_headers "")
    if(TARGET zlibstatic)
        get_target_property(_source_dir zlibstatic SOURCE_DIR)
        get_target_property(_binary_dir zlibstatic BINARY_DIR)
        get_target_property(_sources zlibstatic SOURCES)
        get_filename_component(_expected_source "${CMAKE_BINARY_DIR}/_deps/hp2_zlib-src" REALPATH)
        get_filename_component(_expected_binary "${CMAKE_BINARY_DIR}/_deps/hp2_zlib-build" REALPATH)
        get_filename_component(_source_dir "${_source_dir}" REALPATH)
        get_filename_component(_binary_dir "${_binary_dir}" REALPATH)
        if(_source_dir STREQUAL _expected_source AND _binary_dir STREQUAL _expected_binary)
            foreach(_source IN LISTS _sources)
                if(IS_ABSOLUTE "${_source}")
                    get_filename_component(_header "${_source}" REALPATH)
                else()
                    get_filename_component(_header "${_source_dir}/${_source}" REALPATH)
                endif()
                if(_header STREQUAL "${_expected_binary}/zconf.h")
                    set(_template "${_expected_binary}/zconf.h.cmakein")
                    file(SHA256 "${_header}" _header_sha256)
                    file(SHA256 "${_template}" _template_sha256)
                    set(_cmake_source "${_source_dir}/CMakeLists.txt")
                    set(_input_source "${_source_dir}/zconf.h")
                    file(SHA256 "${_cmake_source}" _cmake_sha256)
                    file(SHA256 "${_input_source}" _input_sha256)
                    set(_headers
                        "{\"target\":\"zlibstatic\",\"path\":\"_deps/hp2_zlib-build/zconf.h\",\"template_path\":\"_deps/hp2_zlib-build/zconf.h.cmakein\",\"template_sha256\":\"${_template_sha256}\",\"source_dir\":\"${_source_dir}\",\"cmake_source\":\"${_cmake_source}\",\"cmake_sha256\":\"${_cmake_sha256}\",\"input_source\":\"${_input_source}\",\"input_sha256\":\"${_input_sha256}\",\"sha256\":\"${_header_sha256}\"}")
                endif()
            endforeach()
        endif()
    endif()
    if(TARGET OpenAL)
        get_target_property(_source_dir OpenAL SOURCE_DIR)
        get_target_property(_binary_dir OpenAL BINARY_DIR)
        get_filename_component(_expected_source "${CMAKE_BINARY_DIR}/_deps/hp2_openal_soft-src" REALPATH)
        get_filename_component(_expected_binary "${CMAKE_BINARY_DIR}/_deps/hp2_openal_soft-build" REALPATH)
        get_filename_component(_source_dir "${_source_dir}" REALPATH)
        get_filename_component(_binary_dir "${_binary_dir}" REALPATH)
        if(_source_dir STREQUAL _expected_source AND _binary_dir STREQUAL _expected_binary)
            foreach(_header config.h config_simd.h)
                set(_output "${_expected_binary}/${_header}")
                set(_template "${_source_dir}/${_header}.in")
                set(_cmake_source "${_source_dir}/CMakeLists.txt")
                if(EXISTS "${_output}" AND EXISTS "${_template}" AND EXISTS "${_cmake_source}")
                    file(SHA256 "${_output}" _header_sha256)
                    file(SHA256 "${_template}" _template_sha256)
                    file(SHA256 "${_cmake_source}" _cmake_sha256)
                    if(_headers)
                        string(APPEND _headers ",")
                    endif()
                    string(APPEND _headers
                        "{\"target\":\"OpenAL\",\"path\":\"_deps/hp2_openal_soft-build/${_header}\",\"template_path\":\"${_template}\",\"template_sha256\":\"${_template_sha256}\",\"source_dir\":\"${_source_dir}\",\"cmake_source\":\"${_cmake_source}\",\"cmake_sha256\":\"${_cmake_sha256}\",\"input_source\":\"${_template}\",\"input_sha256\":\"${_template_sha256}\",\"sha256\":\"${_header_sha256}\"}")
                endif()
            endforeach()
            foreach(_header config_backends.h version.h)
                set(_template "${_source_dir}/${_header}.in")
                _hp2_nf_capture_header(_headers OpenAL "${_source_dir}"
                    "${_expected_binary}/${_header}" "${_template}"
                    "${_source_dir}/CMakeLists.txt" "${_template}")
            endforeach()
            _hp2_nf_capture_header(_headers OpenAL "${_source_dir}"
                "${_expected_binary}/default_hrtf.hpp"
                "${_source_dir}/cmake/bin2h.script.cmake"
                "${_source_dir}/CMakeLists.txt"
                "${_source_dir}/hrtf/Default HRTF.mhr")
        endif()
    endif()
    if(TARGET archive_static)
        get_target_property(_archive_target_source archive_static SOURCE_DIR)
        get_filename_component(_archive_target_source "${_archive_target_source}" REALPATH)
        get_filename_component(_archive_source "${CMAKE_BINARY_DIR}/_deps/hp2_libarchive-src" REALPATH)
        if(_archive_target_source STREQUAL "${_archive_source}/libarchive")
            _hp2_nf_capture_header(_headers archive_static "${_archive_source}"
                "${CMAKE_BINARY_DIR}/_deps/hp2_libarchive-build/config.h"
                "${_archive_source}/build/cmake/config.h.in"
                "${_archive_source}/CMakeLists.txt"
                "${_archive_source}/build/cmake/config.h.in")
        endif()
    endif()
    if(TARGET SDL2-static)
        get_target_property(_sdl_source SDL2-static SOURCE_DIR)
        get_filename_component(_sdl_source "${_sdl_source}" REALPATH)
        if(_sdl_source STREQUAL "${CMAKE_BINARY_DIR}/_deps/hp2_sdl2-src")
            _hp2_nf_capture_header(_headers SDL2-static "${_sdl_source}"
                "${CMAKE_BINARY_DIR}/_deps/hp2_sdl2-build/include/SDL2/SDL_revision.h"
                "${_sdl_source}/include/SDL_revision.h.cmake"
                "${_sdl_source}/CMakeLists.txt"
                "${_sdl_source}/include/SDL_revision.h.cmake")
            _hp2_nf_capture_header(_headers SDL2-static "${_sdl_source}"
                "${CMAKE_BINARY_DIR}/_deps/hp2_sdl2-build/include-config-release/SDL2/SDL_config.h"
                "${_sdl_source}/include/SDL_config.h.cmake"
                "${_sdl_source}/CMakeLists.txt"
                "${_sdl_source}/include/SDL_config.h.cmake")
        endif()
    endif()
    set(${output} "${_headers}" PARENT_SCOPE)
endfunction()

function(hp2_native_free_manifest)
    _hp2_native_free_generated_headers(_generated_header_json)
    set(options)
    set(one_value_args OUTPUT)
    set(multi_value_args PRODUCTS)
    cmake_parse_arguments(HP2NF "${options}" "${one_value_args}" "${multi_value_args}" ${ARGN})
    if(NOT HP2NF_OUTPUT OR NOT HP2NF_PRODUCTS)
        message(FATAL_ERROR "hp2_native_free_manifest requires OUTPUT and PRODUCTS")
    endif()
    set(_json "{\n  \"schema_version\": 1,\n  \"products\": {\n")
    set(_first TRUE)
    foreach(_target IN LISTS HP2NF_PRODUCTS)
        if(NOT TARGET "${_target}")
            message(FATAL_ERROR "native-free manifest names missing target: ${_target}")
        endif()
        get_target_property(_sources "${_target}" SOURCES)
        get_target_property(_links "${_target}" LINK_LIBRARIES)
        if(NOT _sources OR _sources STREQUAL "_sources-NOTFOUND")
            set(_sources "")
        endif()
        if(NOT _links OR _links STREQUAL "_links-NOTFOUND")
            set(_links "")
        endif()
        set(_source_json "")
        foreach(_source IN LISTS _sources)
            if(IS_ABSOLUTE "${_source}")
                set(_resolved_source "${_source}")
            else()
                get_target_property(_source_dir "${_target}" SOURCE_DIR)
                set(_resolved_source "${_source_dir}/${_source}")
            endif()
            string(REPLACE "\\" "\\\\" _resolved_source "${_resolved_source}")
            string(REPLACE "\"" "\\\"" _resolved_source "${_resolved_source}")
            if(_source_json)
                string(APPEND _source_json ", ")
            endif()
            string(APPEND _source_json "\"${_resolved_source}\"")
        endforeach()
        set(_link_json "")
        foreach(_link IN LISTS _links)
            string(REPLACE "\\" "\\\\" _link "${_link}")
            string(REPLACE "\"" "\\\"" _link "${_link}")
            if(_link_json)
                string(APPEND _link_json ", ")
            endif()
            string(APPEND _link_json "\"${_link}\"")
        endforeach()
        get_target_property(_cargo_manifest "${_target}" HP2_NATIVE_FREE_CARGO_MANIFEST)
        if(NOT _cargo_manifest OR _cargo_manifest STREQUAL "_cargo_manifest-NOTFOUND")
            set(_cargo_manifest "")
        endif()
        string(REPLACE "\\" "\\\\" _cargo_manifest "${_cargo_manifest}")
        string(REPLACE "\"" "\\\"" _cargo_manifest "${_cargo_manifest}")
        get_target_property(_cargo_provenance "${_target}" HP2_NATIVE_FREE_CARGO_PROVENANCE)
        if(NOT _cargo_provenance OR _cargo_provenance STREQUAL "_cargo_provenance-NOTFOUND")
            set(_cargo_provenance "")
        endif()
        string(REPLACE "\\" "\\\\" _cargo_provenance "${_cargo_provenance}")
        string(REPLACE "\"" "\\\"" _cargo_provenance "${_cargo_provenance}")
        get_target_property(_rust_objects "${_target}" HP2_NATIVE_FREE_RUST_OBJECTS)
        if(NOT _rust_objects OR _rust_objects STREQUAL "_rust_objects-NOTFOUND")
            set(_rust_objects "")
        endif()
        set(_rust_object_json "")
        foreach(_object IN LISTS _rust_objects)
            if(_rust_object_json)
                string(APPEND _rust_object_json ", ")
            endif()
            string(REPLACE "\\" "\\\\" _object "${_object}")
            string(REPLACE "\"" "\\\"" _object "${_object}")
            string(APPEND _rust_object_json "\"${_object}\"")
        endforeach()
        get_target_property(_installed_file "${_target}" HP2_NATIVE_FREE_INSTALLED_FILE)
        if(NOT _installed_file OR _installed_file STREQUAL "_installed_file-NOTFOUND")
            set(_installed_file "")
        endif()
        string(REPLACE "\\" "\\\\" _installed_file "${_installed_file}")
        string(REPLACE "\"" "\\\"" _installed_file "${_installed_file}")
        if(_first)
            set(_first FALSE)
        else()
            string(APPEND _json ",\n")
        endif()
        if(_generated_header_json)
            set(_generated_headers "[${_generated_header_json}]")
        else()
            set(_generated_headers "[]")
        endif()
        string(APPEND _json "    \"${_target}\": {\"target_file\": \"$<TARGET_FILE:${_target}>\", \"installed_file\": \"${_installed_file}\", \"cargo_manifest\": \"${_cargo_manifest}\", \"cargo_provenance\": \"${_cargo_provenance}\", \"sources\": [${_source_json}], \"inputs\": [${_link_json}], \"rust_objects\": [${_rust_object_json}], \"generated_headers\": ${_generated_headers}}")
    endforeach()
    string(APPEND _json "\n  }\n}\n")
    file(GENERATE OUTPUT "${HP2NF_OUTPUT}" CONTENT "${_json}")
endfunction()

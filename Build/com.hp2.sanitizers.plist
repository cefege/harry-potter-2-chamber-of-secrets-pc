<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- Nightly ASan+UBSan then TSan verification (sequential, separate trees).
     Install: cp Build/com.hp2.sanitizers.plist ~/Library/LaunchAgents/ &&
              launchctl bootstrap gui/$(id -u) ~/Library/LaunchAgents/com.hp2.sanitizers.plist
     Manual:  launchctl start gui/$(id -u)/com.hp2.sanitizers -->
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.hp2.sanitizers</string>
    <key>ProgramArguments</key>
    <array>
        <string>/bin/zsh</string>
        <string>-lc</string>
        <string>cd "$HOME/Code/Default/hp2" &amp;&amp; Build/verify_all.sh macos-arm64 --with-sanitizers</string>
    </array>
    <key>StartCalendarInterval</key>
    <dict>
        <key>Hour</key>
        <integer>2</integer>
        <key>Minute</key>
        <integer>0</integer>
    </dict>
    <key>StandardOutPath</key>
    <string>/tmp/hp2-sanitizers.out</string>
    <key>StandardErrorPath</key>
    <string>/tmp/hp2-sanitizers.err</string>
    <key>EnvironmentVariables</key>
    <dict>
        <key>PATH</key>
        <string>/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin</string>
    </dict>
</dict>
</plist>

//=============================================================================
// Spell lesson sparks for Speed and Accuracy
//=============================================================================
class LessonSparks2 expands particlefx;

defaultproperties
{
    bSteadyState=True
    Speed=(Base=10,Rand=10)
    Lifetime=(Base=1)
    ColorStart=(Base=(R=32,G=41,B=232))
    SizeWidth=(Base=4)
    SizeLength=(Base=10)
    SpinRate=(Base=10)
    Textures(0)=Texture'HPParticle.hp_fx.Particles.Dot_2'
    Rotation=(Pitch=48995)
    AngularSpreadWidth=(Base=60.000000,Rand=60)
    AngularSpreadHeight=(Base=60.000000.Rand=60)
}

//=============================================================================
// SpellDrawFX.
//=============================================================================
class SpellDrawFX expands ParticleFX;


defaultproperties
{
     Distribution=DIST_Uniform
     ParticlesPerSec=(Base=2.000000)
     SourceWidth=(Base=0.000000)
     SourceHeight=(Base=0.000000)
     AngularSpreadWidth=(Base=0.000000)
     AngularSpreadHeight=(Base=0.000000)
     speed=(Base=0.000000)
     Lifetime=(Base=2)
	 ColorDelay=5
	 AlphaDelay=5
     ColorStart=(Base=(R=255,G=0))
     ColorEnd=(Base=(R=128,G=0,B=64))
}

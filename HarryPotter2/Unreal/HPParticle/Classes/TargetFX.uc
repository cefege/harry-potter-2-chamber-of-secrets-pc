//=============================================================================
// TargetFX.
//=============================================================================
class TargetFX expands ParticleFX;

defaultproperties
{
     ParticlesPerSec=(Base=20.000000)
     SourceWidth=(Base=3.000000)
     SourceHeight=(Base=3.000000)
     SourceDepth=(Base=3.000000)
     speed=(Base=0.000000)
     Lifetime=(Base=0.550000)
     ColorStart=(Base=(R=5,G=5,B=169))
     ColorEnd=(Base=(R=113,B=204))
     SizeWidth=(Base=12.000000)
     SizeLength=(Base=12.000000)
     SizeEndScale=(Base=1.250000)
     SpinRate=(Base=4.000000,Rand=-8.000000)
     Textures(0)=Texture'Particles.soft_pfx'
}

//=============================================================================
// TorchFire02.
//=============================================================================
class TorchFire02 expands Fire01;

defaultproperties
{
     ParticlesPerSec=(Base=10.000000)
     SourceWidth=(Base=8.000000)
     SourceHeight=(Base=8.000000)
     SourceDepth=(Base=4.000000)
     AngularSpreadWidth=(Base=5.000000)
     AngularSpreadHeight=(Base=5.000000)
     speed=(Base=10.000000,Rand=10.000000)
     Lifetime=(Base=1.000000,Rand=0.800000)
     ColorStart=(Base=(G=223,B=208),Rand=(R=233,G=33,B=53))
     ColorEnd=(Base=(R=170))
     SizeWidth=(Base=16.000000)
     SizeLength=(Base=16.000000)
     SizeEndScale=(Base=-1.000000,Rand=2.000000)
     SpinRate=(Base=-5.000000,Rand=10.000000)
     DripTime=(Base=0.250000)
}

//=============================================================================
// TorchFire05.
//=============================================================================
class TorchFire05 expands Fire01;

defaultproperties
{
     ParticlesPerSec=(Base=20,Rand=5)
     SourceWidth=(Base=8)
     SourceHeight=(Base=8)
     SourceDepth=(Base=4)
     AngularSpreadWidth=(Base=5)
     AngularSpreadHeight=(Base=5)
     Speed=(Base=20)
     Lifetime=(Base=0.5,Rand=0.4)
     SizeWidth=(Base=7)
     SizeLength=(Base=8)
     SizeEndScale=(Base=1.1,Rand=0.6)
     DripTime=(Base=0.25)
}

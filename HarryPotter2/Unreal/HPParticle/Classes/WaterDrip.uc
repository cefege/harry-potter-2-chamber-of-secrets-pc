//=============================================================================
// WaterDrip.
//=============================================================================
class WaterDrip expands ParticleFX;

defaultproperties
{
     ParticlesPerSec=(Base=0.250000)
     SourceDepth=(Base=2.000000)
     speed=(Base=0.000000)
     Lifetime=(Base=3.500000)
     ColorStart=(Base=(R=16,G=197,B=197))
     ColorEnd=(Base=(R=28,G=170,B=163))
     AlphaEnd=(Base=0.900000)
     SizeWidth=(Base=4.000000)
     SizeLength=(Base=4.000000)
     DripTime=(Base=0.250000)
     Elasticity=0.100000
     Gravity=(Z=-200.000000)
     RenderPrimitive=PPRIM_Liquid
     CollisionHeight=512.000000
}

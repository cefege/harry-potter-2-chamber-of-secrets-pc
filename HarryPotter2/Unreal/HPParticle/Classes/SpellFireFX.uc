class SpellFireFX expands ParticleFX;

defaultproperties
{
     ParticlesPerSec=(Base=40.000000,Rand=5.000000)
     SourceWidth=(Base=8.000000)
     SourceHeight=(Base=8.000000)
     SourceDepth=(Base=4.000000)
     AngularSpreadWidth=(Base=5.000000)
     AngularSpreadHeight=(Base=5.000000)
     SizeWidth=(Base=10.000000)
     SizeLength=(Base=10.000000)
     SizeEndScale=(Base=1.100000,Rand=0.600000)
     DripTime=(Base=0.250000)
	 Gravity=(x=0,y=0,z=-200)
}

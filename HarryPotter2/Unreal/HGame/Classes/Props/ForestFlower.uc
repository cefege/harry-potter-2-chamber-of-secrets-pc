class ForestFlower extends HForest;

defaultproperties
{
     Style=STY_Masked
     Mesh=SkeletalMesh'HPModels.skForestFlowerMesh'
     DrawScale=1.5
     AmbientGlow=0
    CollisionRadius=0
     CollisionHeight=0
     bCollideActors=False
     bCollideWorld=False
     bBlockActors=False
     bBlockPlayers=False
     bRelevantInSoftwareRenderer=False
}

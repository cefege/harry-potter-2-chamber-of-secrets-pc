class ForestBush extends HForest;

defaultproperties
{
     Style=STY_Masked
     Mesh=SkeletalMesh'HPModels.skForestBushMesh'
     ScaleGlow=0.5
     AmbientGlow=0
     CollisionRadius=100
     CollisionHeight=100
     bCollideWorld=False
     bRelevantInSoftwareRenderer=False
}

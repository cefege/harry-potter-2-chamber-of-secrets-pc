//************************************************************************************************************************
function AddMapButton(int x, int y, int w, int h, texture t, string ButtonText, optional string MapLink)
{
	if( TotalNumMapButtons >= MAX_MAP_BUTTONS )
		TotalNumMapButtons = MAX_MAP_BUTTONS - 1;

	Buttons[TotalNumMapButtons].MapButton = UWindowButton(CreateWindow(class'UWindowButton',  x,  y, w, h));
	//MapButtons[TotalNumMapButtons].UpTexture   = t;
	Buttons[TotalNumMapButtons].MapButton.DownTexture = t;
	Buttons[TotalNumMapButtons].MapButton.OverTexture = t;
	Buttons[TotalNumMapButtons].MapButton.Register(self);
	//MapButtons[TotalNumMapButtons].bStretched = true;

	//ButtonText will just be a number, so pad it correctly, and add prefix
	while( len(ButtonText) < 4 )
		ButtonText = "0"$ButtonText;
	ButtonText = "Maps_"$ButtonText;
	Buttons[TotalNumMapButtons].MapButton.ToolTipString = GetLocalFEString( ButtonText );

	if( MapLink != "" )
	{
		Buttons[TotalNumMapButtons].MapLink = int(MapLink);
	}
	else
	{
		Buttons[TotalNumMapButtons].MapLink = -1;
		Buttons[TotalNumMapButtons].MapButton.DownSound = none;
	}

	if( ButtonText != "" )
		Buttons[TotalNumMapButtons].ButtonText = ButtonText;
	else
		Buttons[TotalNumMapButtons].ButtonText = "NO BUTTON TEXT";


	TotalNumMapButtons++;
}

//************************************************************************************************************************
function ToolTip(string strTip)
{
	StatusBarTextWindow.clear();
	StatusBarTextWindow.addText(strTip);
}

//************************************************************************************************************************
function ShowWindow()
{
	UpdateDisplayDetails( );
	Super.ShowWindow ();
}

function PreOpenBook()
{
	ShowWindow();
}

// Update 
function UpdateDisplayDetails()
{
	local int    i;
	local string s;
	local bool   bHarryShownOnMap;
	local name   n;

    //UpdatePreviousNextButons();     // Previous and next buttons
    //UpdatePageCards();              // Small cards, harry card, big card
	//UpdateGroupButtonTextures();    // Gold, silver, bronze group buttons.

	for( i = 0; i < TotalNumMapButtons; i++ )
	{
		if( i >= MapButtonIdx[nCurrPage]  &&  i < MapButtonIdx[nCurrPage]+NumMapButtons[nCurrPage] )
		{
			Buttons[i].MapButton.bDisabled = false;
			Buttons[i].MapButton.ShowWindow();
		}
		else
		{
			Buttons[i].MapButton.bDisabled = true;
			Buttons[i].MapButton.HideWindow();
		}
	}

	//See if this map has a loc marker for the .unr that harry is currently in
	s = GetCurrentUnrFileName();

	//See if harry's inside a MenuMapLocationMarker.  If this function returns '', then harry's not in one.
	n = playerHarry.HarryAtMapMarker();
	//Log("******   ****** n:"$n);

	//Find the match for the returned tag in our list.
	for( i = 0; i < NUM_HARRYLOC_INFO; i++ )
	{
		//If this .unr is present on this map page
		if(   nCurrPage           == HarryLocInfo[i].MapIdx
		   && s                   ~= HarryLocInfo[i].UnrName
		   && HarryLocInfo[i].tag == n  //if harry isn't inside a marker, n will be none, so the default will be picked up.
		  )                             //if hary is inside a marker, n will be the marker's tag, so it'll match up that way.
		{
			bHarryShownOnMap = true;
					
			HarryLocationButton.bDisabled = false;
			HarryLocationButton.ShowWindow();
			HarryLocX = HarryLocInfo[i].x*640/800 - 32;  //oops, the coords are relative to 800x600
			HarryLocY = HarryLocInfo[i].y*480/600 - 32;
			HarryLocationButton.WinLeft = HarryLocX;
			HarryLocationButton.WinTop  = HarryLocY;

			break;
		}
	}

	if( !bHarryShownOnMap )
	{
		HarryLocationButton.bDisabled = true;
		HarryLocationButton.HideWindow();

		if( n != '' ) //check for harry in marker, but no table entry...
			playerHarry.ClientMessage("**** Error: MenuMapLocationMarker.tag="$n$", but no table entry found.");
	}
}

function string GetCurrentUnrFileName()
{
	local string s;
	local int    i;

	s = Caps( GetLevel().GetLocalUrl() );
	s = left( s, instr(s,".UNR")+4 );
	while( true )
	{
		i = instr(s,"\\");
		if( i >= 0 )
			s = Mid( s, i+1 );
		else
			break;
	}

	return s;
}

function Tick(float dtime)
{
	if( !HarryLocationButton.bDisabled )
	{
		HarryLocationButton.WinLeft = HarryLocX + 4 *       Cos( GetLevel().TimeSeconds     * 7);
		HarryLocationButton.WinTop  = HarryLocY + 4 * 0.7 * Sin( GetLevel().TimeSeconds * 2 * 7);
	}
}

// Button messages
function Notify(UWindowDialogControl C, byte E)
{
	local int i;

	if(e==DE_Click)
	{
		//See if one of our buttons was clicked
		for( i = MapButtonIdx[nCurrPage]; i < MapButtonIdx[nCurrPage]+NumMapButtons[nCurrPage]; i++ )
		{
			if(   c == Buttons[i].MapButton
			   && Buttons[i].MapLink != -1
			  )
			{
				nCurrPage = Buttons[i].MapLink;
				UpdateDisplayDetails();
			}					
		}

        if (C == BackPageButton)
            FEBook(book).DoEscapeFromPage();
	}

}

// Paint to display things that are drawn through Unreal windows.
function Paint(Canvas canvas,float x,float y)
{
	local float fScaleFactor;

	fScaleFactor = Canvas.SizeX/WinWidth; 

	DrawBackground( canvas );

	super.Paint(canvas, x, y);

	//PaintLargeCard(Canvas, fScaleFactor);
	//PaintWizardText(Canvas, fScaleFactor);

}

function DrawBackground( canvas canvas )
{
	switch( nCurrPage )
	{
		case 0:
			DrawStretchedTexture( canvas,   0,   0, 256, 256, texture'Map0Texture1' );
			DrawStretchedTexture( canvas, 256,   0, 256, 256, texture'Map0Texture2' );
			DrawStretchedTexture( canvas, 512,   0, 256, 256, texture'Map0Texture3' );
			DrawStretchedTexture( canvas,   0, 256, 256, 256, texture'Map0Texture4' );
			DrawStretchedTexture( canvas, 256, 256, 256, 256, texture'Map0Texture5' );
			DrawStretchedTexture( canvas, 512, 256, 256, 256, texture'Map0Texture6' );
			break;
		case 1:
			DrawStretchedTexture( canvas,   0,   0, 256, 256, texture'Map1Texture1' );
			DrawStretchedTexture( canvas, 256,   0, 256, 256, texture'Map1Texture2' );
			DrawStretchedTexture( canvas, 512,   0, 256, 256, texture'Map1Texture3' );
			DrawStretchedTexture( canvas,   0, 256, 256, 256, texture'Map1Texture4' );
			DrawStretchedTexture( canvas, 256, 256, 256, 256, texture'Map1Texture5' );
			DrawStretchedTexture( canvas, 512, 256, 256, 256, texture'Map1Texture6' );
			break;
		case 2:
			DrawStretchedTexture( canvas,   0,   0, 256, 256, texture'Map2Texture1' );
			DrawStretchedTexture( canvas, 256,   0, 256, 256, texture'Map2Texture2' );
			DrawStretchedTexture( canvas, 512,   0, 256, 256, texture'Map2Texture3' );
			DrawStretchedTexture( canvas,   0, 256, 256, 256, texture'Map2Texture4' );
			DrawStretchedTexture( canvas, 256, 256, 256, 256, texture'Map2Texture5' );
			DrawStretchedTexture( canvas, 512, 256, 256, 256, texture'Map2Texture6' );
			break;
		case 3:
			DrawStretchedTexture( canvas,   0,   0, 256, 256, texture'Map3Texture1' );
			DrawStretchedTexture( canvas, 256,   0, 256, 256, texture'Map3Texture2' );
			DrawStretchedTexture( canvas, 512,   0, 256, 256, texture'Map3Texture3' );
			DrawStretchedTexture( canvas,   0, 256, 256, 256, texture'Map3Texture4' );
			DrawStretchedTexture( canvas, 256, 256, 256, 256, texture'Map3Texture5' );
			DrawStretchedTexture( canvas, 512, 256, 256, 256, texture'Map3Texture6' );
			break;
	}
}

// Preswitch page is called by FEBook before control gets to this menu
function PreSwitchPage()
{
    // Save off Harry for ease of use
	playerHarry = Harry(Root.Console.viewport.actor);

    // Set initial group, page and item on page
	SetInitialSelection();

    Super.PreSwitchPage();
}

// Setup current selection when folio menu is brought up.  The currently
// selected card will be the last card that the player picked up.
function SetInitialSelection()
{
	local string s;
	local int    i;
	local name   HarryAtMapMarkerName;

	//Acually, set the page based on where harry is.

	s = GetCurrentUnrFileName();
	nCurrPage = -1;
	HarryAtMapMarkerName = playerHarry.HarryAtMapMarker();

 	//First, find a match for the filename in our info list, but only look at locations that have tags, and see if harry is in them.
	// This will make sure it hits specific locations in entryhall_hub, Grandstaircase_hub.unr, and Grounds_hub.unr first.
	for( i = 0; i < NUM_HARRYLOC_INFO; i++ )
	{
		if(   s ~= HarryLocInfo[i].UnrName
		   && HarryLocInfo[i].Tag != ''
		   && HarryLocInfo[i].Tag == HarryAtMapMarkerName
		  )
		{
			nCurrPage = HarryLocInfo[i].MapIdx;
			break;
		}
	}

	if( nCurrPage == -1 )
	{
 		//Now, take any match...
		for( i = 0; i < NUM_HARRYLOC_INFO; i++ )
		{
			if(   s ~= HarryLocInfo[i].UnrName
			   && HarryLocInfo[i].Tag == HarryAtMapMarkerName
			  )		
			{
				nCurrPage = HarryLocInfo[i].MapIdx;
				break;
			}
		}
	}

	//Still nothing?  That aint good...
	if( nCurrPage == -1 )
		nCurrPage = 1;
}


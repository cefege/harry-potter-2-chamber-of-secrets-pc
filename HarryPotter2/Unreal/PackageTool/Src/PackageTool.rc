/////////////////////////////////////////////////////////////////////////////
//
// Menu
//

IDM_MainMenu MENU DISCARDABLE 
BEGIN
    POPUP "&File"
    BEGIN
        MENUITEM "&Load Package",               ID_LoadPackage
        MENUITEM "&Save Package",               ID_SavePackage
        MENUITEM SEPARATOR
        MENUITEM "E&xit",                       ID_Exit
    END
    POPUP "&View"
    BEGIN
        MENUITEM "&Refresh",                    ID_Refresh
        MENUITEM "&Log",                        ID_ShowLog
        MENUITEM SEPARATOR
        POPUP "&Filter"
        BEGIN
            MENUITEM "&Objects",                    ID_Filter_AllObjects
            MENUITEM "&Classes",                    ID_Filter_AllClasses
            MENUITEM "&Actors",                     ID_Filter_AllActors
        END
    END
    POPUP "&Object"
    BEGIN
        MENUITEM "&Object Properties",          ID_ShowObject
        MENUITEM SEPARATOR
        MENUITEM "&Create Object",              ID_CreateObject
        MENUITEM "&Destroy Object",             ID_DestroyObject
        MENUITEM SEPARATOR
        MENUITEM "&Import Object",              ID_ImportObject
        MENUITEM "&Export Object",              ID_ExportObject
    END
    POPUP "&Tools"
    BEGIN
        MENUITEM "&Collect Garbage",            ID_CollectGarbage
    END
END


